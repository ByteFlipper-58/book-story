# Release signing config — used by app/build.gradle.kts for *Release builds of every flavor.
#
# HOW TO USE:
#   1. Copy this file to "keystore.properties" in the repo root:
#        cp keystore.properties.example keystore.properties
#   2. Fill in the real values below.
#   3. keystore.properties is git-ignored — never commit it or the .keystore/.jks file.
#
# If this file (or the equivalent -P / env vars) is missing, *Release builds are produced
# UNSIGNED and cannot be uploaded to Google Play / RuStore.
#
# Generate a keystore once (keep it forever — both stores require the same key for updates):
#   keytool -genkey -v -keystore release.keystore -alias everbook \
#           -keyalg RSA -keysize 2048 -validity 10000

RELEASE_STORE_FILE=/absolute/path/to/release.keystore
RELEASE_STORE_PASSWORD=your-store-password
RELEASE_KEY_ALIAS=your-key-alias
RELEASE_KEY_PASSWORD=your-key-password
